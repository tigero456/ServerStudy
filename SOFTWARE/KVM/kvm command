1. vm삭제
    virsh destroy <vm 명>
2. 디스크 삭제
    virsh undefine <vm 명> --remove-all-storage
3. 가상화 생성
    3.1 location 방식
        3.1.1 iso 경로 입력 방식
            virt-install \
            --name <vm 명> \
            --vcpus <cpu 개수> \
            --memory <memory 용량> \
            --disk path=/var/lib/libvirt/images/<vm 명>.qcow2,size=<디스크 사이즈>,format=qcow2 \
            --location /var/lib/libvirt/images/<iso file 명> \
            --os-variant <os 버전> \
            --network bridge=br0,model=virtio \
            --graphics none \
            --extra-args "console=ttyS0,115200n8 inst.text" \
            --console pty,target_type=serial
        3.1.2 mount 방식
            virt-install \
            --name ubuntu2404-vm02-1 \
            --vcpus 2 \
            --memory 4096 \
            --disk path=/var/lib/libvirt/images/ubuntu2404-vm02-1.qcow2,size=15,format=qcow2 \
            --location /mnt,kernel=casper/vmlinuz,initrd=casper/initrd \
            --os-variant ubuntu24.04 \
            --network network=br0,model=virtio \
            --graphics none \
            --extra-args "console=ttyS0,115200n8" \
            --console pty,target_type=serial
        3.1.3 mount 방식 (iso 경로 추가)
            virt-install \
            --name ubuntu2404-vm02-1 \
            --vcpus 2 \
            --memory 4096 \
            --disk path=/var/lib/libvirt/images/ubuntu2404-vm02-1.qcow2,size=15,format=qcow2 \
            --disk path=/var/lib/libvirt/images/ubuntu-24.04.4-live-server-amd64.iso,device=cdrom,readonly=on \
            --location /mnt,kernel=casper/vmlinuz,initrd=casper/initrd \
            --os-variant ubuntu24.04 \
            --network bridge=br0,model=virtio \
            --graphics none \
            --extra-args "console=ttyS0,115200n8" \
            --console pty,target_type=serial
    3.2 cdrom 방식
        virt-install \
            --name ubuntu2404-vm02 \
            --vcpus 2 \
            --memory 4096 \
            --disk path=/var/lib/libvirt/images/ubuntu2404-vm02.qcow2,size=15,format=qcow2 \
            --cdrom /var/lib/libvirt/images/ubuntu-24.04.4-live-server-amd64.iso \
            --os-variant ubuntu24.04 \
            --network network=default,model=virtio \
            --graphics vnc,listen=0.0.0.0 \
            --console pty,target_type=serial
4. vm 재기동
    virsh reboot <vm 명>
5. vm 접속
    virsh console <vm 명>
6. 콘솔 접속 해제
    Ctrl+]
6. vm 리스트 확인
    virsh list --all
    